class CranePendulumEnv:
    def __init__(self, dt=0.04):
        self.dt = dt
        self.H = 100

        # Parametri fisici
        # self.M = 1.0   # massa carrello
        # self.m = 0.1   # massa pendolo
        # self.l = 0.5   # lunghezza pendolo
        # self.g = 9.81  # gravità
