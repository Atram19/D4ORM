    def get_reward(self, q, u):
        theta, dtheta, x, dx = q

        # Parametri fisici
        m, M, l, g = self.m, self.M, self.l, self.g

        # Scale max per normalizzazione
        dtheta_max = 6.0
        u_max = 10.0
        x_max = 5.0

        # === Energie ===
        # Energia cinetica totale
        E_kin = 0.5 * M * dx**2 \
            + 0.5 * m * ((dx + l * dtheta * jnp.cos(theta))**2 +
                        (l * dtheta * jnp.sin(theta))**2)

        # Energia potenziale corretta
        E_pot = m * g * l * (1 - jnp.cos(theta))   # 0 in basso, max in alto
        E_pot_norm = E_pot / (2 * m * g * l)       # normalizza in [0,1]

        # === Stabilizzazione attorno a π ===
        delta_theta = (theta - jnp.pi + jnp.pi) % (2 * jnp.pi) - jnp.pi
        r_goal = jnp.exp(- (delta_theta / 0.2)**2)   # gaussiana centrata su π

        # === Penalità morbide ===
        r_x = 1.0 / (1.0 + (x/x_max)**2)
        r_u = 1.0 / (1.0 + (u/u_max)**2)

        # === Reward combinata ===
        reward = (
            4.0 * E_pot_norm +    # swing-up
            3.0 * r_goal +        # stabilizzazione in alto
            0.5 * r_x +           # carrello vicino al centro
            0.2 * r_u             # controllo dolce
        ) / (4.0 + 3.0 + 0.5 + 0.2)

        # Ritorna anche termini utili per debug
        r_terms = jnp.array([E_pot_norm, r_goal, r_x, r_u])
        return reward, r_terms




    def render(self, x_traj, U=None, rewards=None, r_terms=None, tag=""):
        

        x_traj = jax.device_get(x_traj)
        T = x_traj.shape[0]
        t = jnp.linspace(0, T * self.dt, T)

        theta = x_traj[:, 0]
        dtheta = x_traj[:, 1]
        x = x_traj[:, 2]
        dx = x_traj[:, 3]

        os.makedirs("results/crane/figs", exist_ok=True)

        # === 1. Stati principali ===
        fig, axs = plt.subplots(4, 1, figsize=(8, 10), sharex=True)
        fig.suptitle(f"Carroponte - Stati [{tag}]")

        axs[0].plot(t, theta)
        axs[0].set_ylabel("theta (rad)")

        axs[1].plot(t, dtheta)
        axs[1].set_ylabel("dtheta/dt (rad/s)")

        axs[2].plot(t, x)
        axs[2].set_ylabel("x (m)")

        axs[3].plot(t, dx)
        axs[3].set_ylabel("dx/dt (m/s)")
        axs[3].set_xlabel("Tempo (s)")

        plt.tight_layout()
        plt.savefig(f"results/crane/figs/states_{tag}.png")
        plt.close()

        # === 2. Controllo ===
        if U is not None:
            U = jax.device_get(U).squeeze()
            t_u = jnp.linspace(0, T * self.dt, U.shape[0])

            plt.figure(figsize=(6, 3))
            plt.plot(t_u, U)
            plt.title(f"Forza di controllo [{tag}]")
            plt.xlabel("Tempo (s)")
            plt.ylabel("F (N)")
            plt.grid(True)
            plt.tight_layout()
            plt.savefig(f"results/crane/figs/control_{tag}.png")
            plt.close()

        # === 3. Energie e reward ===
        if r_terms is not None:
            r_terms = jax.device_get(r_terms)
            E_pot = r_terms[:, 0]
            E_kin = r_terms[:, 1]

            plt.figure(figsize=(7, 4))
            plt.plot(t, E_pot, label="Energia potenziale")
            plt.plot(t, E_kin, label="Energia cinetica")
            plt.title(f"Energie [{tag}]")
            plt.xlabel("Tempo (s)")
            plt.ylabel("Energia (J)")
            plt.legend()
            plt.grid(True)
            plt.tight_layout()
            plt.savefig(f"results/crane/figs/energy_{tag}.png")
            plt.close()

        # === 4. Reward totale ===
        if rewards is not None:
            rewards = jax.device_get(rewards)
            t_r = jnp.linspace(0, rewards.shape[0] * self.dt, rewards.shape[0])

            plt.figure(figsize=(6, 3))
            plt.plot(t_r, rewards)
            plt.title(f"Reward totale [{tag}]")
            plt.xlabel("Tempo (s)")
            plt.ylabel("Reward")
            plt.grid(True)
            plt.tight_layout()
            plt.savefig(f"results/crane/figs/reward_{tag}.png")
            plt.close()

        # === 5. Errore angolare rispetto al goal ===
        delta_theta = jnp.mod(theta + jnp.pi, 2*jnp.pi) - jnp.pi
        plt.figure(figsize=(6, 3))
        plt.plot(t, delta_theta, label="Errore angolare (rad)")
        plt.axhline(0, color='k', linestyle='--', lw=1)
        plt.title(f"Errore rispetto all'equilibrio instabile  [{tag}]")
        plt.xlabel("Tempo (s)")
        plt.ylabel("e_theta (rad)")
        plt.grid(True)
        plt.legend()
        plt.tight_layout()
        plt.savefig(f"results/crane/figs/error_theta_{tag}.png")
        plt.close()


