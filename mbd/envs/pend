        # self.D = self.l * (self.M + self.m)
        self.l = 0.5
        self.g = 9.80665
        self.r = 0.02

        self.m1 = 0.2
        self.m2 = 0.022245336
        self.M  = 0.6

        self.b1 = 1e-5
        self.b2 = 1e-5

        # Parametri derivati
        self.B = self.m1 + self.m2 / 3.0
        self.C = self.m1 + self.m2 + self.M
        self.D = (2.0 / 5.0) * self.m1 * self.r ** 2


        # Azione massima (forza)
        self.max_u =4

        # Stato iniziale e goal: pendolo in basso -> in alto
        self.q0 = jnp.array([0.1, 0.1, 0.1, 0.1])
        self.qf = jnp.array([jnp.pi, 0.0, 0.0, 0.0])

    def dynamics(self, q, u):
        theta, dtheta, x, dx = q
        # Parametri locali
        B, C, D = self.B, self.C, self.D
        g, l = self.g, self.l
        b1, b2 = self.b1, self.b2

        # Dinamica esplicita
        dq1 = dtheta
        dq2 = (-b1*dtheta)/D \
            + ((-b2*dx - g*l*jnp.sin(theta)*B) * l*jnp.cos(theta)*B) / ((C + l*jnp.cos(theta)*B)*D) \
            - (g*l*jnp.sin(theta)*B)/D \
            - u * (l*jnp.cos(theta)*B) / ((C + l*jnp.cos(theta)*B)*D)

        dq3 = dx
        
        dq4 = (-b2*dx - g*l*jnp.sin(theta)*B)/(C + l*jnp.cos(theta)*B) \
            + u / ((C + l*jnp.cos(theta)*B)*D)

        dq1 = dq1.reshape(())
        dq2 = dq2.reshape(())
        dq3 = dq3.reshape(())
        dq4 = dq4.reshape(())
        return jnp.array([dq1, dq2, dq3, dq4])


    def rk4(self, f, x, u, dt):
        k1 = f(x, u)
        k2 = f(x + dt/2 * k1, u)
        k3 = f(x + dt/2 * k2, u)
        k4 = f(x + dt * k3, u)
        return x + dt/6 * (k1 + 2*k2 + 2*k3 + k4)

    @partial(jax.jit, static_argnums=(0,))
    def reset(self, rng):
        return State(pipeline_state=self.q0, reward=0.0, r_terms=jnp.zeros(3))

    @partial(jax.jit, static_argnums=(0,))
    def step(self, state: State, action: jax.Array) -> State:
        u = jnp.clip(action, -1.0, 1.0) 
        action_scaled = u* self.max_u
        q_next = self.rk4(self.dynamics, state.pipeline_state, action_scaled, self.dt)
        r, r_terms = self.get_reward(q_next, u)
      
        return State(pipeline_state=q_next, reward=r, r_terms=r_terms)

    def get_reward(self, q, u, v_max=1.0, w_max=6.0, lam=0.6, alpha_theta=1.0):
        theta, dtheta, x, dx = q
        m = self.m1 + self.m2
        M = self.M
        l = self.l
        g = self.g

        # === Potenziale normalizzato ===
        E_pot_norm = 0.5 * (1.0 + jnp.cos(theta))
        # === Cinetica normalizzata ===
        E_kin = (
            0.5 * (M + m) * dx**2
            + 0.5 * m * ((dx + l * jnp.cos(theta) * dtheta)**2 + (-l * jnp.sin(theta) * dtheta)**2)
        )
        E0 = 0.5*(M+m)*v_max**2 + 0.5*m*((v_max + l*w_max)**2 + (l*w_max)**2)
        E_kin_norm = 1.0 - jnp.exp(-E_kin / (E0 + 1e-8))

        # === Reward base ===
        r_base = lam * E_pot_norm + (1.0 - lam) * (1.0 - E_kin_norm)

        # === Penalizzazione controllo (facoltativa) ===
        r_u = -0.01 * u**2

        # === Penalizzazione angolo fuori range ===
        theta_max = jnp.pi/2
        r_theta = -alpha_theta * jnp.maximum(0.0, jnp.abs(theta) - theta_max)**2

        # === Reward totale ===
        
        r_base = jnp.asarray(r_base).reshape(())
        r_theta = jnp.asarray(r_theta).reshape(())
        r_u = jnp.asarray(r_u).reshape(())
        E_pot_norm = jnp.asarray(E_pot_norm).reshape(())
        E_kin_norm = jnp.asarray(E_kin_norm).reshape(())
       # jax.debug.print("r_base: {r_base}, r_u: {r_u}, r_theta: {r_theta}, E_pot: {E_pot}, E_kin: {E_kin}", r_base=r_base, r_u=r_u, r_theta=r_theta, E_pot=E_pot_norm, E_kin=E_kin_norm)
        r_total = r_base + r_u + r_theta
        r_total = jnp.asarray(r_total).reshape(())

        # Termini singoli (debug)
        r_terms = jnp.array([E_pot_norm, -(E_kin_norm), r_u])
        return r_total, r_terms



    def render(self, x_traj, U=None, rewards=None, r_terms=None, tag=""):
        import matplotlib.pyplot as plt
        import os

        x_traj = jax.device_get(x_traj)
        T = x_traj.shape[0]
        t = jnp.linspace(0, T * self.dt, T)

        fig, axs = plt.subplots(4, 1, figsize=(8, 10), sharex=True)
        fig.suptitle(f"Carroponte - Traiettoria Ottimizzata [{tag}]")

        theta = x_traj[:, 0]
        dtheta = x_traj[:, 1]
        x = x_traj[:, 2]
        dx = x_traj[:, 3]

        axs[0].plot(t, theta)
        axs[0].set_ylabel("θ (rad)")

        axs[1].plot(t, dtheta)
        axs[1].set_ylabel("dtheta/dt (rad/s)")

        axs[2].plot(t, x)
        axs[2].set_ylabel("x (m)")

        axs[3].plot(t, dx)
        axs[3].set_ylabel("dx/dt (m/s)")
        axs[3].set_xlabel("Tempo (s)")

        plt.tight_layout()
        os.makedirs("results/crane/figs", exist_ok=True)
        plt.savefig(f"results/crane/figs/states_{tag}.png")
        plt.close()

        # === Plot controllo ===
        if U is not None:
            U = jax.device_get(U).squeeze()
            t_u = jnp.linspace(0, T * self.dt, U.shape[0])

            plt.figure(figsize=(6, 3))
            plt.plot(t_u, U)
            plt.title(f"Forza di controllo [{tag}]")
            plt.xlabel("Tempo (s)")
            plt.ylabel("F (N)")
            plt.grid(True)
            plt.tight_layout()
            plt.savefig(f"results/crane/figs/control_{tag}.png")
            plt.close()

        # === Plot reward terms ===
        if r_terms is not None:
            r_terms = jax.device_get(r_terms)
            n_terms = r_terms.shape[1]
            labels = [f"r{i}" for i in range(n_terms)]

            plt.figure(figsize=(7, 4))
            for i in range(n_terms):
                plt.plot(t, r_terms[:, i], label=labels[i])
            plt.title(f"Termini di reward [{tag}]")
            plt.xlabel("Tempo (s)")
            plt.legend()
            plt.grid(True)
            plt.tight_layout()
            plt.savefig(f"results/crane/figs/r_terms_{tag}.png")
            plt.close()

        # === Plot reward totale ===
        if rewards is not None:
            rewards = jax.device_get(rewards)
            t_r = jnp.linspace(0, rewards.shape[0] * self.dt, rewards.shape[0])

            plt.figure(figsize=(6, 3))
            plt.plot(t_r, rewards)
            plt.title(f"Reward totale [{tag}]")
            plt.xlabel("Tempo (s)")
            plt.ylabel("Reward")
            plt.grid(True)
            plt.tight_layout()
            plt.savefig(f"results/crane/figs/reward_{tag}.png")
            plt.close()


