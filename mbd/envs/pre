# === Stato iniziale ===
q = np.array([0.1, 0.1, 0.1, 0.1])
qd = np.zeros(4)

# === Setup simulazione ===
dt = 0.001
T_sim = 5
steps = int(T_sim / dt)

E_kin = []
E_pot = []
E_tot = []

# === Funzione energia potenziale ===
def compute_potential_energy(robot, q):
    V = 0
    T_links = robot.fkine_all(q)
    for i, link in enumerate(robot.links):
        T_i = T_links[i]
        p_cmi = T_i @ SE3(link.r)  # posizione CM nel world frame
        z = p_cmi.t[2]  # coordinata z
        V += link.m * 9.81 * z
    return V
x = np.concatenate((q, qd))  # stato iniziale
tau = np.zeros(4)
for _ in range(steps):
    x = rk4(robot_dynamics, x, tau, dt)
    q = x[:4]
    qd = x[4:]

    B = robot.inertia(q)
    if np.linalg.cond(B) > 1e10:
        print("⚠️ B è quasi singolare!")
    T = 0.5 * qd.T @ B @ qd
    V = compute_potential_energy(robot, q)

    E_kin.append(T)
    E_pot.append(V)
    E_tot.append(T + V)

    

# === Plot ===
t = np.arange(0, T_sim, dt)
plt.figure()
plt.plot(t, E_kin, label='Energia cinetica')
plt.plot(t, E_pot, label='Energia potenziale')
plt.plot(t, E_tot, label='Energia totale')
plt.xlabel("Tempo [s]")
plt.ylabel("Energia [J]")
plt.title("Energia meccanica del robot RRPR (Corke)")
plt.legend()
